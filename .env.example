# Notivo 配置文件
# 复制此文件为 .env 并填入你的 API Key

# AI 服务商: anthropic 或 openai
NOTIVO_PROVIDER=anthropic

# 模型: claude-sonnet-5 / claude-opus-5 / gpt-4o / gpt-4o-mini 等
NOTIVO_MODEL=claude-sonnet-5

# API Key（Anthropic 或 OpenAI）
NOTIVO_API_KEY=sk-your-key-here

# OpenAI 兼容 API 的 Base URL（仅 provider=openai 时需要）
NOTIVO_BASE_URL=https://api.openai.com

# Whisper API Key（留空则使用上方 NOTIVO_API_KEY）
NOTIVO_WHISPER_KEY=

# 服务端口
PORT=8000
